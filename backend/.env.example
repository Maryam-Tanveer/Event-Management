# =========================================================
# LuxeEvents Backend - Environment Variables Template
# =========================================================
# Is file ko copy karo => .env
# Apni real values daalo
# .env KABHI GitHub pe push mat karo!
# =========================================================

# MongoDB Atlas Connection String
# https://cloud.mongodb.com pe jaao => Connect => Drivers => copy karo
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/event_management?retryWrites=true&w=majority

# JWT Secret - Koi bhi strong random string (64+ characters)
# Generate karne ke liye: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here_minimum_64_characters

# CORS - Frontend ka URL
# Development: http://localhost:3000
# Production:  https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# Environment
# Development: development
# Production:  production
NODE_ENV=development

# Gmail - Forgot Password emails ke liye
# Gmail App Password banane ka tarika:
# 1. myaccount.google.com => Security => 2-Step Verification ON karo
# 2. Security => App Passwords => "Mail" select karo => Generate
# 3. 16 character password copy karo (spaces ke bina daalo)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# Cloudinary - Image Upload ke liye
# https://cloudinary.com => Free account banao => Dashboard se copy karo
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe - Payment ke liye
# https://dashboard.stripe.com => Developers => API Keys
# Test:  sk_test_...
# Live:  sk_live_...
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Tax Rate (optional) - Default: 0.05 (5%)
# Frontend REACT_APP_TAX_RATE bhi set karo
TAX_RATE=0.05

