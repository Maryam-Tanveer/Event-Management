# =========================================================
# LuxeEvents Frontend - Environment Variables Template
# =========================================================
# Is file ko copy karo => .env
# Apni real values daalo
# .env KABHI GitHub pe push mat karo!
# =========================================================

# Stripe Publishable Key
# https://dashboard.stripe.com => Developers => API Keys => Publishable Key
# Test:  pk_test_...
# Live:  pk_live_...
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key
REACT_APP_API_URL=https://aapka-backend-url.vercel.app
# Backend API URL (optional - agar proxy use nahi karna chahte)
# Development mein package.json ka proxy use hota hai (http://localhost:5000)
# Production mein ye set karo:
# REACT_APP_API_URL=https://your-backend-domain.com
